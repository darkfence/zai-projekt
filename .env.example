# Skopiuj do .env i uzupełnij. Hasła generuj np.: openssl rand -hex 24
# (w hasłach Postgresa unikaj znaków specjalnych – trafiają do adresu URL połączenia)

# Domena wskazująca na serwer, np. 151-115-74-168.sslip.io
DOMAIN=localhost
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=0

SECRET_KEY=change-me
TOKEN_TTL=3600

POSTGRES_DB=zai
POSTGRES_USER=zai
POSTGRES_PASSWORD=change-me

INFLUX_DB=zai
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me
INFLUX_USER=zai
INFLUX_PASSWORD=change-me

# Konto administratora tworzone przy pierwszym starcie (jeśli nie istnieje)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
